RUST_LOG=info

# GRAFANA_OTLP_URL must include the signal path. The exporter uses this value
# verbatim, so the `https://otlp-gateway-<zone>.grafana.net/otlp` value shown in
# Grafana Cloud's UI 404s on every export -- append `/v1/metrics`. Note that
# OTEL_EXPORTER_OTLP_METRICS_ENDPOINT and OTEL_EXPORTER_OTLP_ENDPOINT, if set in
# the environment, silently take precedence over this variable.
# GRAFANA_OTLP_URL=
# GRAFANA_OTLP_USER=
# GRAFANA_CLOUD_API_KEY=

# Reported as the k8s.cluster.name / k8s.pod.name metric attributes (optional)
# CLUSTER_NAME=
# POD_NAME=

# It's used for near-lake-framework
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

MONGODB_USERNAME=
MONGODB_PASSWORD=
MONGODB_HOST=

NEAR_OMNI_ACCOUNT_ID=
NEAR_OMNI_PRIVATE_KEY=

NEAR_FAST_ACCOUNT_ID=
NEAR_FAST_PRIVATE_KEY=

INFURA_API_KEY=
ETH_PRIVATE_KEY=
BASE_PRIVATE_KEY=
ARB_PRIVATE_KEY=
BNB_PRIVATE_KEY=
POL_PRIVATE_KEY=
HLEVM_PRIVATE_KEY=
ABS_PRIVATE_KEY=

# Note that solana private key must be encoded to bs58 string in order to use it
SOLANA_PRIVATE_KEY=
# Note that fogo private key must be encoded to bs58 string in order to use it
FOGO_PRIVATE_KEY=

STARKNET_PRIVATE_KEY=
STARKNET_ACCOUNT_ADDRESS=

# NATS credentials (must match nats.conf or your NATS server config)
BRIDGE_NATS_USERNAME=
BRIDGE_NATS_PASSWORD=
